# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Connection URL
MONGODB_URI=mongodb://localhost:27017/laptop_shop

# JWT Secret Key for Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# Default Admin Credentials for Auto-seeding
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
ADMIN_EMAIL=admin@yasinwahablaptops.com

# Cloudinary Image Storage Configuration
# Sign up free at https://cloudinary.com and get your credentials from the Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
